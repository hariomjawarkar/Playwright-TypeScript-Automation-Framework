{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "npx playwright test",
    "clean:results": "npx rimraf allure-results allure-report playwright-report test-results",
    "pretest": "npm run clean:results",
    "test:dev": "cross-env ENV=dev npx playwright test",
    "docker:build": "docker build -t playwright-framework .",
    "docker:run": "docker run --rm -v ${PWD}/allure-results:/app/allure-results playwright-framework",
    "test:stage": "cross-env ENV=stage npx playwright test",
    "test:prod": "cross-env ENV=prod npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:ddt": "npx playwright test --grep @ddt",
    "test:visual": "npx playwright test --grep @visual",
    "test:visual:update": "npx playwright test --grep @visual --update-snapshots",
    "test:industrial": "npx playwright test --grep \"@smoke|@regression|@visual|@ddt|@mocking\"",
    "report:html": "npx playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "allure-commandline": "^2.37.0",
    "allure-playwright": "^3.5.0",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
